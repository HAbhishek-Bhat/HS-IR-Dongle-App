# Cloud sync backend: "rest" | "firebase" | "none"
CLOUD_PROVIDER=rest
REST_API_BASE_URL=https://api.example.com/v1
REST_API_TIMEOUT_MS=30000

# Auth
AUTH_MODE=email
# SSO would use AUTH_MODE=sso and SSO_ISSUER_URL

# Feature flags
ENABLE_MOCK_SIMULATOR=true
ENABLE_CRASH_REPORTING=false
SENTRY_DSN=

# Encryption (generate a unique key per deployment; store in Keychain at runtime)
# Do not put real secrets in committed .env files
APP_ENV=development
